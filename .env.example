# =============================================================================
# Pomvix — Local development environment template
# =============================================================================
# Copy this file to `.env` and adjust as needed:
#
#   cp .env.example .env
#
# Then run with:
#
#   docker compose up --build
#
# If host ports 3000 or 8000 are already taken, copy the local override template:
#
#   cp docker-compose.override.example.yml docker-compose.override.yml
#
# Compose loads docker-compose.override.yml automatically (gitignored). Default alternate
# host ports: frontend 13471, backend 18471. Internal ports stay 3000 and 8000.
# =============================================================================

# Runtime environment
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://pomvix:pomvix@db:5432/pomvix
POSTGRES_USER=pomvix
POSTGRES_PASSWORD=pomvix
POSTGRES_DB=pomvix

# Security — use a long random value, even in development
SECRET_KEY=dev-only-change-me-to-a-long-random-secret

# Frontend / CORS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CONTACT_EMAIL=hello@pomvix.com
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# Cookies / sessions
COOKIE_SECURE=false

# SMTP (optional in development — leave SMTP_HOST empty to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=hello@pomvix.com
EMAIL_TO=hello@pomvix.com

# API behaviour
DOCS_ENABLED=true
RATE_LIMIT=5/minute