# =============================================================================
# Pomvix — Production environment template
# =============================================================================
# Copy this file to `.env.production` and fill in real values:
#
#   cp .env.production.example .env.production
#
# Then deploy with:
#
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# NEVER commit `.env.production` — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime environment
# -----------------------------------------------------------------------------
# Must be "production" in production. Controls production-safe behaviour.
ENVIRONMENT=production

# Disable debug mode. Never set to true in production.
DEBUG=false

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Async SQLAlchemy URL used by the backend. The host `db` is the compose
# service name and is only reachable inside the Docker network.
DATABASE_URL=postgresql+asyncpg://pomvix:CHANGE_ME_DB_PASSWORD@db:5432/pomvix

# Credentials used by the PostgreSQL container itself. Must match the
# credentials in DATABASE_URL above.
POSTGRES_USER=pomvix
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=pomvix

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Long random secret (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET

# -----------------------------------------------------------------------------
# Frontend / CORS
# -----------------------------------------------------------------------------
# Public origin of the site, e.g. https://pomvix.com
NEXT_PUBLIC_SITE_URL=https://pomvix.com

# Public API base URL. When served behind the nginx reverse proxy, the API is
# available on the same origin under /api/v1.
NEXT_PUBLIC_API_URL=https://pomvix.com

# Public contact email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=hello@pomvix.com

# Backend CORS origin. Defaults to FRONTEND_URL when CORS_ORIGINS is empty.
FRONTEND_URL=https://pomvix.com

# Optional comma-separated list of additional allowed CORS origins, e.g.:
#   CORS_ORIGINS=https://pomvix.com,https://www.pomvix.com
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Cookies / sessions
# -----------------------------------------------------------------------------
# Send cookies only over HTTPS. Keep true in production (TLS is terminated
# by nginx or your load balancer).
COOKIE_SECURE=true

# -----------------------------------------------------------------------------
# SMTP (contact-form email notifications)
# -----------------------------------------------------------------------------
# Leave SMTP_HOST empty to disable email sending (submissions are still saved
# to the database).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_SMTP_USERNAME
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_USE_TLS=true

# Sender and recipient addresses for contact-form notifications.
EMAIL_FROM=hello@pomvix.com
EMAIL_TO=hello@pomvix.com

# -----------------------------------------------------------------------------
# API behaviour
# -----------------------------------------------------------------------------
# Expose /docs and /redoc. Keep false in production.
DOCS_ENABLED=false

# Contact endpoint rate limit.
RATE_LIMIT=5/minute

# Migration backup policy. Backups are mandatory by default.
BACKUP_RETENTION_DAYS=14
ALLOW_MIGRATION_WITHOUT_BACKUP=false